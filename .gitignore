.DS_Store
**/.DS_Store
__pycache__/
**/__pycache__/
*.pyc
*.pyo
node_modules/
.env
.claude/settings.local.json

# Input/output data files (keep folders via .gitkeep)
# eventlog/: ignore generated/example OCEL logs, but keep the container
# logistics input log and the arrow-semantics constructed test fixtures.
src/Simulation/IO/input/eventlog/*.xml
src/Simulation/IO/input/eventlog/*.json
!src/Simulation/IO/input/eventlog/container_logistics.json
!src/Simulation/IO/input/eventlog/Example_OCEL_arrow_*.json
src/Simulation/IO/input/ocdeclare/*.json
src/Simulation/IO/input/ocdeclare/*.txt
src/Simulation/IO/input/parameters/*.json
src/Simulation/IO/output/eventlogs/*.json

# Simulation metrics output (can be very large — regenerated on each run)
metrics/*.json
metrics/*.jsonl

# Frontend build output
Frontend/dist/
