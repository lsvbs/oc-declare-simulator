.DS_Store
**/.DS_Store
__pycache__/
**/__pycache__/
*.pyc
*.pyo
node_modules/
.env
.claude/settings.local.json

# Input/output data files (keep folders via .gitkeep)
# eventlog/: ignore generated/example OCEL logs, but keep the container
# logistics input log and the arrow-semantics constructed test fixtures.
Backend/src/Simulation/IO/input/eventlog/*.xml
Backend/src/Simulation/IO/input/eventlog/*.json
!Backend/src/Simulation/IO/input/eventlog/container_logistics.json
!Backend/src/Simulation/IO/input/eventlog/Example_OCEL_arrow_*.json
Backend/src/Simulation/IO/input/ocdeclare/*.json
Backend/src/Simulation/IO/input/ocdeclare/*.txt
Backend/src/Simulation/IO/input/parameters/*.json
Backend/src/Simulation/IO/output/eventlogs/*.json

# Simulation metrics output (can be very large — regenerated on each run)
Backend/metrics/*.json
Backend/metrics/*.jsonl

# Frontend build output
Frontend/dist/
Backend/src/Simulation/IO/input/eventlog/*.jsonocel
